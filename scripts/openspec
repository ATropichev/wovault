#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cli="$repo_root/tools/openspec/node_modules/.bin/openspec"
if [[ ! -x "$cli" ]]; then
  echo 'Run scripts/setup-tools in the WOVault checkout first.' >&2
  exit 1
fi
export OPENSPEC_TELEMETRY=0
exec "$cli" "$@"
